{
  "name": "app-store",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build-prod": "ng build --configuration production --base-href /app-store/ --deploy-url /app-store/ --output-path dist/app/",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "format-only": "prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format": "eslint --fix \"src/**/*.ts\" && prettier --write \"src/**/*.{ts,html,scss,css,json}\"",
    "format:check": "eslint \"src/**/*.ts\" && prettier --check \"src/**/*.{ts,html,scss,css,json}\"",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "serve-dev": "ng serve --configuration development --host $HOSTNAME --ssl"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "dependencies": {
    "@angular/animations": "22.1.7",
    "@angular/cdk": "22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@fontsource-variable/material-symbols-outlined": "^5.3.6",
    "@fontsource/roboto": "^5.3.0",
    "angular-auth-oidc-client": "^22.0.0",
    "lodash-es": "^4.18.1",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.0",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/parser": "^8.70.0",
    "angular-eslint": "^22.5.0",
    "autoprefixer": "^10.6.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.18",
    "prettier": "^3.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "^5.0.1"
  }
}